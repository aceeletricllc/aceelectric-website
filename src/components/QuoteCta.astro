---
interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Ready to talk about your project?',
  text = 'Tell us about your property and preferred contact method. We respond during business hours.',
} = Astro.props;
---

<section class="quote-cta" aria-labelledby="quote-cta-heading">
  <div class="container quote-cta__inner">
    <div>
      <h2 id="quote-cta-heading">{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href="/contact">Contact us</a>
      <a class="btn btn--outline" href="/services">Browse services</a>
    </div>
  </div>
</section>

<style>
  .quote-cta {
    background: linear-gradient(
      135deg,
      var(--color-black),
      var(--color-navy-800) 55%,
      rgb(178 34 34 / 35%)
    );
    color: var(--color-white);
    padding-block: var(--space-2xl);
  }

  .quote-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
  }

  .quote-cta p {
    max-width: 36rem;
    color: var(--color-muted);
    margin-bottom: 0;
  }

  .quote-cta .btn--outline {
    border-color: var(--color-accent);
    color: var(--color-white);
    background: transparent;
  }

  .quote-cta .btn--outline:hover {
    background: rgb(230 184 0 / 14%);
    color: var(--color-white);
  }

  @media (max-width: 639px) {
    .quote-cta__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .quote-cta .btn-row {
      flex-direction: column;
      width: 100%;
    }

    .quote-cta .btn-row .btn {
      width: 100%;
    }
  }
</style>
