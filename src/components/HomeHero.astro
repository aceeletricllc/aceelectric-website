---
import { business } from '../config/business';
import { homeHeroSlides } from '../data/home-hero';
import { formatTelHref, isConfigured } from '../utils/config';

const phoneReady = isConfigured(business.phone);
const estimateHref = '/contact#quote-form';
---

<section class="home-hero" aria-labelledby="home-hero-heading">
  <div class="home-hero__media" aria-hidden="true">
    {
      homeHeroSlides.map((slide, index) => (
        <div
          class="home-hero__slide"
          data-hero-slide
          data-active={index === 0 ? 'true' : 'false'}
        >
          <img
            src={slide.src}
            alt=""
            width={1920}
            height={1080}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </div>
      ))
    }
    <div class="home-hero__scrim" />
  </div>

  <p class="visually-hidden" aria-live="polite" data-hero-status></p>

  <div class="container home-hero__content">
    <ul class="home-hero__badges" role="list">
      <li>
        <span class="home-hero__badge">
          <svg
            class="home-hero__badge-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Licensed &amp; insured
        </span>
      </li>
      <li>
        <span class="home-hero__badge">
          <svg
            class="home-hero__badge-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
            <path d="M12 6a6 6 0 0 0-6 6h12a6 6 0 0 0-6-6z"></path>
          </svg>
          Fast response
        </span>
      </li>
      <li>
        <a class="home-hero__badge home-hero__badge--accent" href={estimateHref}>
          <svg
            class="home-hero__badge-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 2v20"></path>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          Free estimates
        </a>
      </li>
    </ul>

    <h1 id="home-hero-heading">
      NM licensed <span class="home-hero__accent">electricians</span>
    </h1>
    <p class="home-hero__subhead">
      Serving Albuquerque and the Southwest for 24+ years
    </p>
    <p class="home-hero__lead">
      Residential and commercial panel work, repairs, lighting, EV charging, and code-conscious
      upgrades with clear communication from quote to walk-through.
    </p>

    <div class="btn-row home-hero__actions">
      {
        phoneReady && (
          <a class="btn btn--accent" href={formatTelHref(business.phone)}>
            Call or text {business.phone}
          </a>
        )
      }
      <a class="btn btn--ghost" href={estimateHref}>Request service</a>
    </div>
  </div>

  <div class="home-hero__curve" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path
        fill="var(--color-surface)"
        d="M0,52 C480,108 960,8 1440,44 L1440,100 L0,100 Z"
      />
    </svg>
  </div>
</section>

<script define:vars={{ slideAlts: homeHeroSlides.map((s) => s.alt) }}>
  function initHomeHero() {
    const root = document.querySelector('.home-hero');
    if (!(root instanceof HTMLElement)) return;

    const slides = Array.from(root.querySelectorAll('[data-hero-slide]'));
    const status = root.querySelector('[data-hero-status]');
    if (slides.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const durations = [4000, 8000, 12000];
    let durationStep = 0;
    let index = slides.findIndex((slide) => slide.getAttribute('data-active') === 'true');
    if (index < 0) index = 0;

    function announce() {
      if (status && slideAlts[index]) {
        status.textContent = `Showing photo ${index + 1} of ${slides.length}: ${slideAlts[index]}`;
      }
    }

    function show(next) {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.setAttribute('data-active', i === index ? 'true' : 'false');
      });
      announce();
    }

    announce();

    if (reducedMotion || slides.length < 2) return;

    function scheduleNext() {
      const delay = durations[durationStep % durations.length];
      durationStep += 1;
      window.setTimeout(() => {
        show(index + 1);
        scheduleNext();
      }, delay);
    }

    scheduleNext();
  }

  initHomeHero();
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    min-height: min(72vh, 34rem);
    display: flex;
    align-items: center;
    padding-block: var(--space-xl) calc(var(--space-2xl) + 2.75rem);
    color: var(--color-white);
    overflow: hidden;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-navy-900);
  }

  .home-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .home-hero__slide[data-active='true'] {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide {
      transition: none;
    }
  }

  .home-hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(0.82);
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgb(0 0 0 / 78%) 0%,
      rgb(0 0 0 / 48%) 42%,
      rgb(0 0 0 / 28%) 100%
    );
    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .home-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
  }

  .home-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    background: rgb(255 255 255 / 14%);
    border: 1px solid rgb(255 255 255 / 28%);
    color: var(--color-white);
    text-decoration: none;
  }

  .home-hero__badge-icon {
    flex-shrink: 0;
  }

  .home-hero__badge--accent {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .home-hero__badge--accent:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-text);
  }

  .home-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-sm);
    text-transform: capitalize;
  }

  .home-hero__accent {
    color: var(--color-accent);
    text-transform: none;
  }

  .home-hero__subhead {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: rgb(255 255 255 / 92%);
  }

  .home-hero__lead {
    font-size: 1.0625rem;
    color: var(--color-muted);
    margin-bottom: var(--space-xl);
    max-width: 36rem;
  }

  .home-hero__actions .btn--accent {
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    color: var(--color-accent-text);
  }

  .home-hero__actions .btn--accent:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-text);
  }

  .home-hero__actions .btn--ghost {
    background: transparent;
    border: 2px solid rgb(255 255 255 / 75%);
    color: var(--color-white);
  }

  .home-hero__actions .btn--ghost:hover {
    background: rgb(255 255 255 / 12%);
    color: var(--color-white);
  }

  .home-hero__curve {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    z-index: 2;
    line-height: 0;
    pointer-events: none;
  }

  .home-hero__curve svg {
    display: block;
    width: 100%;
    height: clamp(3rem, 8vw, 5rem);
  }

  @media (max-width: 639px) {
    .home-hero {
      min-height: min(68vh, 30rem);
      padding-block: var(--space-lg) calc(var(--space-xl) + 2.25rem);
    }

    .home-hero__slide img {
      transform: scale(0.78);
    }

    .home-hero__actions {
      flex-direction: column;
    }

    .home-hero__actions .btn {
      width: 100%;
    }
  }
</style>
