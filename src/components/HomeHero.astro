---
import { business } from '../config/business';
import { homeHeroSlides } from '../data/home-hero';
import { formatTelHref, isConfigured } from '../utils/config';

const phoneReady = isConfigured(business.phone);
const estimateHref = '/contact#quote-form';
---

<section class="home-hero" aria-labelledby="home-hero-heading" data-hero>
  <div class="home-hero__media" aria-hidden="true">
    {
      homeHeroSlides.map((slide, index) => (
        <div class:list={['home-hero__slide', { 'is-active': index === 0 }]} data-hero-slide>
          <img
            src={slide.src}
            alt=""
            width={1920}
            height={1080}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        </div>
      ))
    }
    <div class="home-hero__scrim" />
  </div>

  <div class="container home-hero__content">
    <ul class="home-hero__badges" role="list">
      <li>
        <span class="home-hero__badge">
          <svg
            class="home-hero__badge-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Licensed &amp; insured
        </span>
      </li>
      <li>
        <span class="home-hero__badge">
          <svg
            class="home-hero__badge-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"></path>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
            <path d="M12 6a6 6 0 0 0-6 6h12a6 6 0 0 0-6-6z"></path>
          </svg>
          Fast response
        </span>
      </li>
      <li>
        <a class="home-hero__badge home-hero__badge--accent" href={estimateHref}>
          <svg
            class="home-hero__badge-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 2v20"></path>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
          </svg>
          Free estimates
        </a>
      </li>
    </ul>

    <h1 id="home-hero-heading">
      NM licensed <span class="home-hero__accent">electricians</span>
    </h1>
    <p class="home-hero__subhead">
      Serving Albuquerque and the Southwest for 24+ years
    </p>
    <p class="home-hero__lead">
      Residential and commercial panel work, repairs, lighting, EV charging, and code-conscious
      upgrades with clear communication from quote to walk-through.
    </p>

    <div class="btn-row home-hero__actions">
      {
        phoneReady && (
          <a class="btn btn--accent" href={formatTelHref(business.phone)}>
            Call or text {business.phone}
          </a>
        )
      }
      <a class="btn btn--ghost" href={estimateHref}>Request service</a>
    </div>
  </div>

  <div class="home-hero__dots" role="tablist" aria-label="Hero image slides">
    {
      homeHeroSlides.map((slide, index) => (
        <button
          type="button"
          class="home-hero__dot"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-label={`Slide ${index + 1}: ${slide.alt}`}
          data-hero-dot={index}
        />
      ))
    }
  </div>

  <div class="home-hero__curve" aria-hidden="true">
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path
        fill="var(--color-surface)"
        d="M0,52 C480,108 960,8 1440,44 L1440,100 L0,100 Z"
      />
    </svg>
  </div>
</section>

<script is:inline>
  (function () {
    function initHeroCarousel() {
      var hero = document.querySelector('[data-hero]');
      if (!hero) return;

      var slides = hero.querySelectorAll('[data-hero-slide]');
      var dots = hero.querySelectorAll('[data-hero-dot]');
      if (slides.length < 2) return;

      var index = 0;

      function show(next) {
        index = (next + slides.length) % slides.length;
        for (var i = 0; i < slides.length; i += 1) {
          slides[i].classList.toggle('is-active', i === index);
        }
        for (var j = 0; j < dots.length; j += 1) {
          dots[j].setAttribute('aria-selected', j === index ? 'true' : 'false');
        }
      }

      for (var d = 0; d < dots.length; d += 1) {
        (function (dotIndex) {
          dots[dotIndex].addEventListener('click', function () {
            show(dotIndex);
          });
        })(d);
      }

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      window.setInterval(function () {
        show(index + 1);
      }, 4000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroCarousel);
    } else {
      initHeroCarousel();
    }
  })();
</script>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    min-height: min(92vh, 44rem);
    display: flex;
    align-items: center;
    padding-block: var(--space-2xl) calc(var(--space-3xl) + 3rem);
    color: var(--color-white);
    overflow: hidden;
  }

  .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-navy-900);
  }

  .home-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  .home-hero__slide.is-active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__slide {
      transition: none;
    }
  }

  .home-hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .home-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgb(0 0 0 / 78%) 0%,
      rgb(0 0 0 / 48%) 42%,
      rgb(0 0 0 / 28%) 100%
    );
    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .home-hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
  }

  .home-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    background: rgb(255 255 255 / 14%);
    border: 1px solid rgb(255 255 255 / 28%);
    color: var(--color-white);
    text-decoration: none;
  }

  .home-hero__badge-icon {
    flex-shrink: 0;
  }

  .home-hero__badge--accent {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-text);
  }

  .home-hero__badge--accent:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-text);
  }

  .home-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--space-sm);
    text-transform: capitalize;
  }

  .home-hero__accent {
    color: var(--color-accent);
    text-transform: none;
  }

  .home-hero__subhead {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: rgb(255 255 255 / 92%);
  }

  .home-hero__lead {
    font-size: 1.0625rem;
    color: var(--color-muted);
    margin-bottom: var(--space-xl);
    max-width: 36rem;
  }

  .home-hero__actions .btn--accent {
    background: var(--color-accent);
    border: 2px solid var(--color-accent);
    color: var(--color-accent-text);
  }

  .home-hero__actions .btn--accent:hover {
    background: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: var(--color-accent-text);
  }

  .home-hero__actions .btn--ghost {
    background: transparent;
    border: 2px solid rgb(255 255 255 / 75%);
    color: var(--color-white);
  }

  .home-hero__actions .btn--ghost:hover {
    background: rgb(255 255 255 / 12%);
    color: var(--color-white);
  }

  .home-hero__dots {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 4.5rem;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-xs);
  }

  .home-hero__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    border: 1px solid var(--color-white);
    background: transparent;
    padding: 0;
    cursor: pointer;
    min-width: 1.5rem;
    min-height: 1.5rem;
    background-clip: content-box;
    box-sizing: border-box;
  }

  .home-hero__dot[aria-selected='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .home-hero__dot:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  .home-hero__curve {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    z-index: 2;
    line-height: 0;
    pointer-events: none;
  }

  .home-hero__curve svg {
    display: block;
    width: 100%;
    height: clamp(3rem, 8vw, 5rem);
  }

  @media (max-width: 639px) {
    .home-hero {
      min-height: min(88vh, 36rem);
      padding-block: var(--space-xl) calc(var(--space-2xl) + 2.5rem);
    }

    .home-hero__dots {
      bottom: 3.75rem;
    }

    .home-hero__actions {
      flex-direction: column;
    }

    .home-hero__actions .btn {
      width: 100%;
    }
  }
</style>
