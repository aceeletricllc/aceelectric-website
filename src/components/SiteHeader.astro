---
import { business } from '../config/business';
import { mainNav, site } from '../config/site';
import { getAllServices } from '../data/services';
import { formatTelHref, isConfigured } from '../utils/config';

const phoneReady = isConfigured(business.phone);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const services = getAllServices();
const isServicesSection = currentPath === '/services' || currentPath.startsWith('/services/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">
      <img
        class="site-logo__img"
        src={site.logo.src}
        alt={site.logo.alt}
        width={site.logo.width}
        height={site.logo.height}
        decoding="async"
      />
      <span class="visually-hidden">{business.displayName}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          mainNav.map((item) => {
            if (item.href !== '/services') {
              const href = item.href;
              const normalized = href.replace(/\/$/, '') || '/';
              const isCurrent = currentPath === normalized;
              return (
                <li>
                  <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              );
            }

            return (
              <li class="site-nav__item--services">
                <a
                  href="/services"
                  class="site-nav__services-link"
                  aria-current={isServicesSection ? 'page' : undefined}
                  aria-haspopup="true"
                  aria-expanded="false"
                  id="services-nav-trigger"
                >
                  Services
                </a>
                <div class="services-dropdown" aria-labelledby="services-nav-trigger">
                  <p class="services-dropdown__heading">
                    <a href="/services">All services</a>
                  </p>
                  <ul class="services-dropdown__list">
                    {
                      services.map((service) => (
                        <li>
                          <a href={`/services/${service.slug}`}>{service.title}</a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        phoneReady && (
          <a class="btn btn--outline site-header__call" href={formatTelHref(business.phone)}>
            Call
          </a>
        )
      }
      <a class="btn btn--primary" href="/contact">Contact us</a>
    </div>

    <details class="site-nav-mobile">
      <summary class="site-nav-mobile__toggle">
        <span class="visually-hidden">Open menu</span>
        <span aria-hidden="true">Menu</span>
      </summary>
      <div class="site-nav-mobile__panel">
        <ul>
          {
            mainNav.map((item) =>
              item.href === '/services' ? (
                <li class="site-nav-mobile__services">
                  <a href="/services">Services</a>
                  <ul>
                    {
                      services.map((service) => (
                        <li>
                          <a href={`/services/${service.slug}`}>{service.title}</a>
                        </li>
                      ))
                    }
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ),
            )
          }
        </ul>
        <div class="btn-row">
          {
            phoneReady && (
              <a class="btn btn--outline" href={formatTelHref(business.phone)}>
                Call
              </a>
            )
          }
          <a class="btn btn--primary" href="/contact">Contact us</a>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const servicesItem = document.querySelector('.site-nav__item--services');
  const trigger = document.querySelector('#services-nav-trigger');
  const dropdown = servicesItem?.querySelector('.services-dropdown');

  let closeTimer;

  function openServicesMenu() {
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = undefined;
    }
    servicesItem?.classList.add('is-services-open');
    trigger?.setAttribute('aria-expanded', 'true');
  }

  function scheduleCloseServicesMenu() {
    if (closeTimer) clearTimeout(closeTimer);
    closeTimer = setTimeout(() => {
      servicesItem?.classList.remove('is-services-open');
      trigger?.setAttribute('aria-expanded', 'false');
      closeTimer = undefined;
    }, 280);
  }

  if (servicesItem instanceof HTMLElement && trigger instanceof HTMLElement) {
    servicesItem.addEventListener('mouseenter', openServicesMenu);
    servicesItem.addEventListener('mouseleave', scheduleCloseServicesMenu);

    if (dropdown instanceof HTMLElement) {
      dropdown.addEventListener('mouseenter', openServicesMenu);
      dropdown.addEventListener('mouseleave', scheduleCloseServicesMenu);
    }

    trigger.addEventListener('focus', openServicesMenu);
    servicesItem.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && servicesItem.contains(event.relatedTarget)) return;
      scheduleCloseServicesMenu();
    });
  }

  const mobileNav = document.querySelector('.site-nav-mobile');
  if (mobileNav instanceof HTMLDetailsElement) {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileNav.open) {
        mobileNav.open = false;
        mobileNav.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-white);
    color: var(--color-black);
    box-shadow: var(--shadow-sm);
    border-bottom: 4px solid var(--color-black);
    padding-top: env(safe-area-inset-top, 0px);
  }

  .site-header a {
    color: var(--color-black);
    text-decoration: none;
  }

  .site-header a:hover {
    color: var(--color-primary);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: var(--header-height);
    flex-wrap: wrap;
  }

  .site-logo {
    display: flex;
    align-items: center;
    margin-right: auto;
  }

  .site-logo__img {
    width: auto;
    height: clamp(4.5rem, 12vw, 6.75rem);
    max-width: min(420px, 72vw);
  }

  @media (max-width: 959px) {
    .site-logo__img {
      height: clamp(3.25rem, 14vw, 4.25rem);
      max-width: min(280px, 58vw);
    }

    .site-header__inner {
      min-height: var(--header-height);
      flex-wrap: nowrap;
    }
  }

  .site-nav__list {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-lg);
    align-items: center;
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--color-primary);
    font-weight: 600;
  }

  .site-nav__item--services {
    position: relative;
  }

  /* Keeps hover active while moving from the link down into the panel */
  .site-nav__item--services::after {
    content: '';
    position: absolute;
    left: -0.75rem;
    right: -0.75rem;
    top: 100%;
    height: 0.75rem;
  }

  .site-nav__services-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .services-dropdown {
    display: none;
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%);
    width: min(44rem, 92vw);
    background: var(--color-white);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-md);
    z-index: 60;
  }

  /* Invisible bridge so the pointer can reach the panel without leaving hover */
  .services-dropdown::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -0.65rem;
    height: 0.65rem;
  }

  .site-nav__item--services.is-services-open .services-dropdown,
  .site-nav__item--services:hover .services-dropdown,
  .site-nav__item--services:focus-within .services-dropdown {
    display: block;
  }

  .services-dropdown__heading {
    margin: 0 0 var(--space-sm);
    font-weight: 700;
    border-bottom: 1px solid rgb(0 0 0 / 12%);
    padding-bottom: var(--space-sm);
  }

  .services-dropdown__list {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: var(--space-lg);
  }

  .services-dropdown__list li {
    break-inside: avoid;
    margin-bottom: var(--space-xs);
  }

  .services-dropdown__list a {
    display: block;
    padding: 0.35rem 0;
    font-size: 0.9375rem;
    line-height: 1.35;
  }

  .site-header__actions {
    display: none;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-header__call {
    color: var(--color-black);
  }

  .site-nav-mobile {
    position: relative;
  }

  .site-nav-mobile__toggle {
    list-style: none;
    cursor: pointer;
    min-height: 3rem;
    min-width: 3rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    color: var(--color-black);
  }

  .site-nav-mobile__toggle::-webkit-details-marker {
    display: none;
  }

  .site-nav-mobile__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: min(20rem, 92vw);
    max-height: 80vh;
    overflow: auto;
    background: var(--color-white);
    color: var(--color-black);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 959px) {
    .site-nav-mobile[open] .site-nav-mobile__panel {
      position: fixed;
      left: var(--page-gutter);
      right: var(--page-gutter);
      top: calc(var(--header-height) + env(safe-area-inset-top, 0px) + 0.5rem);
      width: auto;
      max-height: min(
        70vh,
        calc(100dvh - var(--header-height) - var(--mobile-bar-height) - env(safe-area-inset-bottom, 0px) - 1.5rem)
      );
      z-index: 55;
    }
  }

  .site-nav-mobile__panel ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  .site-nav-mobile__panel li a {
    display: block;
    padding: 0.625rem 0;
    min-height: 2.75rem;
  }

  .site-nav-mobile__services ul {
    margin: 0 0 var(--space-md) var(--space-md);
  }

  .site-nav-mobile__services > a {
    font-weight: 700;
  }

  @media (min-width: 960px) {
    .site-nav__list {
      display: flex;
    }

    .site-header__actions {
      display: flex;
    }

    .site-nav-mobile {
      display: none;
    }

    .site-header__inner {
      flex-wrap: nowrap;
    }
  }

  @media (min-width: 1100px) {
    .services-dropdown__list {
      columns: 3;
    }
  }
</style>
