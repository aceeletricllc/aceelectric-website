---
import { business } from '../config/business';
import { mainNav, site } from '../config/site';
import { getAllServices } from '../data/services';
import { formatTelHref, isConfigured } from '../utils/config';

const phoneReady = isConfigured(business.phone);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const services = getAllServices();
const isServicesSection = currentPath === '/services' || currentPath.startsWith('/services/');
---

<div class="site-header-group">
  <div class="site-topbar">
    <div class="container site-topbar__inner">
      <p class="site-topbar__text">
        {
          isConfigured(business.licenseNumber) ? (
            <>
              NM License #{business.licenseNumber}
              <span class="site-topbar__sep" aria-hidden="true">•</span>
              24+ years experience
            </>
          ) : (
            <>
              NM licensed electricians
              <span class="site-topbar__sep" aria-hidden="true">•</span>
              24+ years experience
            </>
          )
        }
      </p>
      <a class="site-topbar__cta" href="/contact#quote-form">Free estimates</a>
    </div>
  </div>

  <header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">
      <img
        class="site-logo__img"
        src={site.logo.src}
        alt={site.logo.alt}
        width={site.logo.width}
        height={site.logo.height}
        decoding="async"
      />
      <span class="visually-hidden">{business.displayName}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          mainNav.map((item) => {
            const href = item.href;
            const normalized = href.replace(/\/$/, '') || '/';
            const isCurrent =
              href === '/services'
                ? isServicesSection
                : currentPath === normalized;
            return (
              <li>
                <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      {
        phoneReady && (
          <a class="btn btn--outline site-header__call" href={formatTelHref(business.phone)}>
            Call
          </a>
        )
      }
      <a class="btn btn--primary" href="/contact">Contact us</a>
    </div>

    <details class="site-nav-mobile">
      <summary class="site-nav-mobile__toggle">
        <span class="visually-hidden">Open menu</span>
        <span aria-hidden="true">Menu</span>
      </summary>
      <div class="site-nav-mobile__panel">
        <ul>
          {
            mainNav.map((item) =>
              item.href === '/services' ? (
                <li>
                  <details class="site-nav-mobile__services">
                    <summary>Services</summary>
                    <ul>
                      <li>
                        <a href="/services">All services</a>
                      </li>
                      {
                        services.map((service) => (
                          <li>
                            <a href={`/services/${service.slug}`}>{service.title}</a>
                          </li>
                        ))
                      }
                    </ul>
                  </details>
                </li>
              ) : (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ),
            )
          }
        </ul>
        <div class="btn-row">
          {
            phoneReady && (
              <a class="btn btn--outline" href={formatTelHref(business.phone)}>
                Call
              </a>
            )
          }
          <a class="btn btn--primary" href="/contact">Contact us</a>
        </div>
      </div>
    </details>
  </div>
  </header>
</div>

<script>
  const mobileNav = document.querySelector('.site-nav-mobile');
  if (mobileNav instanceof HTMLDetailsElement) {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileNav.open) {
        mobileNav.open = false;
        mobileNav.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header-group {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-topbar {
    background: var(--color-navy-900);
    color: var(--color-muted);
    font-size: 0.8125rem;
    border-bottom: 1px solid rgb(255 255 255 / 8%);
  }

  .site-topbar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 2.5rem;
    padding-block: var(--space-xs);
  }

  .site-topbar__text {
    margin: 0;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .site-topbar__sep {
    margin-inline: 0.35rem;
    color: var(--color-slate);
  }

  .site-topbar__cta {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .site-topbar__cta:hover {
    background: var(--color-accent-hover);
    color: var(--color-accent-text);
  }

  .site-header {
    position: relative;
    top: auto;
    background: var(--color-white);
    color: var(--color-black);
    box-shadow: var(--shadow-sm);
    border-bottom: 4px solid var(--color-black);
    padding-top: env(safe-area-inset-top, 0px);
  }

  .site-header a {
    color: var(--color-black);
    text-decoration: none;
  }

  .site-header a:hover {
    color: var(--color-primary);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: var(--header-height);
    flex-wrap: wrap;
  }

  .site-logo {
    display: flex;
    align-items: center;
    margin-right: auto;
  }

  .site-logo__img {
    width: auto;
    height: clamp(4.5rem, 12vw, 6.75rem);
    max-width: min(420px, 72vw);
  }

  @media (max-width: 959px) {
    .site-logo__img {
      height: clamp(3.25rem, 14vw, 4.25rem);
      max-width: min(280px, 58vw);
    }

    .site-header__inner {
      min-height: var(--header-height);
      flex-wrap: nowrap;
    }
  }

  .site-nav__list {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-lg);
    align-items: center;
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--color-primary);
    font-weight: 600;
  }

  .site-header__actions {
    display: none;
    align-items: center;
    gap: var(--space-sm);
  }

  .site-header__call {
    color: var(--color-black);
  }

  .site-nav-mobile {
    position: relative;
  }

  .site-nav-mobile__toggle {
    list-style: none;
    cursor: pointer;
    min-height: 3rem;
    min-width: 3rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--color-black);
    border-radius: var(--radius-md);
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    color: var(--color-black);
  }

  .site-nav-mobile__toggle::-webkit-details-marker {
    display: none;
  }

  .site-nav-mobile__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    width: min(20rem, 92vw);
    max-height: 80vh;
    overflow: auto;
    background: var(--color-white);
    color: var(--color-black);
    border: 2px solid var(--color-black);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 959px) {
    .site-nav-mobile[open] .site-nav-mobile__panel {
      position: fixed;
      left: var(--page-gutter);
      right: var(--page-gutter);
      top: calc(var(--sticky-header-total) + env(safe-area-inset-top, 0px) + 0.5rem);
      width: auto;
      max-height: min(
        70vh,
        calc(100dvh - var(--header-height) - var(--mobile-bar-height) - env(safe-area-inset-bottom, 0px) - 1.5rem)
      );
      z-index: 55;
    }
  }

  .site-nav-mobile__panel ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  .site-nav-mobile__panel li a {
    display: block;
    padding: 0.625rem 0;
    min-height: 2.75rem;
  }

  .site-nav-mobile__services {
    margin-bottom: var(--space-xs);
  }

  .site-nav-mobile__services summary {
    cursor: pointer;
    font-weight: 700;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0.625rem 0;
  }

  .site-nav-mobile__services summary::-webkit-details-marker {
    display: none;
  }

  .site-nav-mobile__services summary::after {
    content: '+';
    margin-left: auto;
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1;
  }

  .site-nav-mobile__services[open] summary::after {
    content: '−';
  }

  .site-nav-mobile__services ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-sm) var(--space-md);
  }

  @media (min-width: 960px) {
    .site-nav__list {
      display: flex;
    }

    .site-header__actions {
      display: flex;
    }

    .site-nav-mobile {
      display: none;
    }

    .site-header__inner {
      flex-wrap: nowrap;
    }
  }
</style>
