---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteCta from '../components/QuoteCta.astro';
import { business } from '../config/business';
import { isConfigured } from '../utils/config';
---

<BaseLayout
  title="About Ace Electric LLC"
  description="Learn about Ace Electric LLC—our approach to safe electrical work, communication, and long-term reliability for homes and businesses."
  path="/about"
>
  <section class="section">
    <div class="container prose">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
      <h1>About {business.displayName}</h1>
      <p class="lead">
        We are a professional electrical contractor focused on safe installations, honest scopes of work,
        and respectful service at your property.
      </p>

      <section aria-labelledby="approach">
        <h2 id="approach">Our approach</h2>
        <p>
          Electrical systems should be easy to understand and safe to live with. We take time to inspect,
          explain findings, and document what we recommend before turning circuits back on.
        </p>
        <p>
          Whether you need a single device replaced or a panel upgrade that supports modern loads, we
          coordinate scheduling, materials, and inspections when they apply to your project.
        </p>
      </section>

      <section aria-labelledby="credentials">
        <h2 id="credentials">Credentials & coverage</h2>
        <ul>
          {
            isConfigured(business.licenseNumber) ? (
              <li>License: {business.licenseNumber}</li>
            ) : (
              <li>License information will be published here once confirmed in site configuration.</li>
            )
          }
          {
            isConfigured(business.insuranceStatus) ? (
              <li>{business.insuranceStatus}</li>
            ) : (
              <li>Insurance details will be published here once confirmed in site configuration.</li>
            )
          }
          {
            isConfigured(business.yearsInBusiness) && <li>{business.yearsInBusiness}</li>
          }
        </ul>
      </section>

      {
        business.serviceAreas.length > 0 && (
          <section aria-labelledby="service-area">
            <h2 id="service-area">Service area</h2>
            <p>We serve: {business.serviceAreas.join(', ')}.</p>
          </section>
        )
      }
    </div>
  </section>
  <QuoteCta heading="Talk with our team" text="Share your project goals and we will outline next steps." />
</BaseLayout>
